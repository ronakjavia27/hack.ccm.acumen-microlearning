# hack.CCM API Keys Configuration
# ================================
# At least ONE key is required. Copy this file to .env and fill in your keys.

# OpenRouter API key (recommended - used by default for Pass 1 extraction)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary Gemini API key (optional - used when --llm gemini)
PRIMARY_GEMINI_API_KEY=your_gemini_api_key_here

# Backup Gemini API key (optional - fallback if primary is rate-limited)
BACKUP_GEMINI_API_KEY=your_backup_gemini_api_key_here

# Gemini API key for trial condensation (optional - used with --model gemini in condense_trials.py)
CONDENSATION_GEMINI_API_KEY=your_gemini_api_key_here


# =====================================================================
# MODEL CONFIGURATION (Pass 1 Summary + Pass 2 Pearls per provider)
# =====================================================================
# --- OpenRouter models (used when --llm openrouter) ---
OPENROUTER_SUMMARY_MODEL=deepseek-ai/DeepSeek-V4-Pro
OPENROUTER_SUMMARY_FALLBACK=deepseek-ai/DeepSeek-V4-Pro
OPENROUTER_PEARLS_MODEL=openai/gpt-oss-20b
OPENROUTER_PEARLS_FALLBACK=openai/gpt-oss-120b

# --- Gemini models (used when --llm gemini) ---
GEMINI_SUMMARY_MODEL=gemini-3.6-flash
GEMINI_PEARLS_MODEL=gemini-3.6-flash

# --- Subtopic classification (Pass 1.5, auto at generation time) ---
SUBTOPIC_LLM_MODEL=openai/gpt-oss-20b                   # OpenRouter: subtopic classifier
GEMINI_SUBTOPIC_MODEL=gemini-3.1-flash-lite             # Gemini: subtopic classifier

# --- Other specialized models ---
GEMINI_VISION_MODEL=gemini-2.0-flash                    # OCR figure transcription
GEMINI_CONDENSATION_MODEL=gemini-3.6-flash              # Trial condensation (condense_trials.py)
CONDENSATION_TENCENT_MODEL=tencent/hy3:free             # Tencent model on OpenRouter


# =====================================================================
# FLASHCARD LLM (convert/tag/regenerate)
# A cheap model keeps the flashcard layer off the high-end default. If unset,
# falls back to OPENROUTER_SUMMARY_MODEL.
# FLASHCARD_LLM_API_KEY=your_api_key_here (defaults to OPENROUTER_API_KEY)
# FLASHCARD_LLM_BASE_URL=your_base_url_here (defaults to OpenRouter)
FLASHCARD_LLM_MODEL=deepseek/deepseek-chat-v3-0324

# Front-question model (only used for flashcard front generation)
# If unset, inherits FLASHCARD_LLM_MODEL.
# QUESTION_LLM_API_KEY=your_api_key_here (defaults to OPENROUTER_API_KEY)
# QUESTION_LLM_BASE_URL=your_base_url_here (defaults to OpenRouter)
